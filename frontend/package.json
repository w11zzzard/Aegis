{
  "name": "aegis-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-check.mjs",
    "test:integration": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "zod": "^4.0.0", "@fontsource/geist": "^5.2.0" },
  "devDependencies": {
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0", "vite": "^7.0.0", "typescript": "^5.9.0",
    "vitest": "^3.2.0", "@vitest/coverage-v8": "^3.2.0", "jsdom": "^26.0.0",
    "@testing-library/react": "^16.0.0", "@testing-library/user-event": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0", "@playwright/test": "^1.55.0"
  }
}
